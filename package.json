{
  "name": "aiuis",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "build:web": "turbo build --filter=web",
    "web": "turbo dev --filter=web",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "check": "turbo run typecheck test",
    "optimise": "turbo run optimise",
    "msdf": "turbo run msdf",
    "score:moodboard": "pnpm --dir scripts/score-moodboard exec tsx score-moodboard-tiles.ts",
    "deploy:web": "pnpm --filter web run deploy",
    "seed:content": "node scripts/seed-content-software.mjs",
    "content": "pnpm --dir ../content.software exec -- node packages/cli/bin/content.mjs",
    "lint": "oxlint"
  },
  "devDependencies": {
    "@local/tailwind": "workspace:*",
    "@tailwindcss/postcss": "^4.1.15",
    "oxlint": "^1.76.0",
    "prettier-plugin-classnames": "^0.9.0",
    "tailwindcss": "^4.1.15",
    "turbo": "^2.9.16",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22"
  }
}
