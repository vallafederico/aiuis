{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aiuis",
	"main": ".output/server/index.mjs",
	"compatibility_date": "2026-07-01",
	"compatibility_flags": ["nodejs_compat"],
	// prerendered pages + /public land here; run_worker_first ensures the
	// worker runs before assets so www→apex redirect fires for every request
	"assets": {
		"directory": ".output/public",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	// secrets (set via `wrangler secret put`, never in vars): TYPESAFE_API_KEY,
	// AI_GATEWAY_API_KEY, CF_API_TOKEN (Zone Read + Zone Analytics Read + Account Analytics Read)
	"vars": {
		"CONTENT_PROJECT_ID": "project_aiuis",
		"CONTENT_API_URL": "https://aiuis.content.software",
		"CONTENT_CDN_URL": "https://cdn.content.software/aiuis"
	},
	"ai": {
		"binding": "AI"
	},
	"observability": {
		"enabled": true
	},
	// custom_domain:true triggers a 409 when orphaned A records already exist
	// in the zone; register zone routes instead (DNS already points to CF)
	"routes": [
		{ "pattern": "aiu.is/*", "zone_name": "aiu.is" },
		{ "pattern": "www.aiu.is/*", "zone_name": "aiu.is" }
	]
}
