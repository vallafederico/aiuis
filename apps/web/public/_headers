# Cloudflare static assets: cache rules for files that are not content-hashed
# (/_build/* already is). A week with background revalidation; fonts change
# rarely enough to cache for a year.

/moodboard/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/msdf/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
