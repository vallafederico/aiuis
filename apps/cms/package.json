{
  "name": "cms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run --config vitest.node.config.ts && vitest run --config vitest.config.ts --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply aiuis-cms-db --local",
    "seed": "tsx scripts/seed.ts",
    "seed:pieces": "npx tsx scripts/seed-pieces.ts",
    "migrate:notes": "npx tsx scripts/migrate-notes.ts",
    "mint-token": "tsx scripts/mint-token.ts",
    "bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "mirror": "npx tsx scripts/mirror-content.ts",
    "mirror:watch": "npx tsx scripts/mirror-content.ts --watch",
    "provision": "tsx scripts/provision.ts",
    "mirror:remote": "tsx scripts/mirror-to-remote.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.19.0",
    "diff": "^9.0.0",
    "hono": "^4.12.32",
    "mdast-util-to-string": "^4.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "shiki": "^4.3.1",
    "ulid": "^3.0.2",
    "unified": "^11.0.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260724.1",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "5.7.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
