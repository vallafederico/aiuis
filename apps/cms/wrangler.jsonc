{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aiuis-cms",
  "workers_dev": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aiuis-cms-db",
      "database_id": "f8882adb-7cc5-4cdf-87cd-114a154baee9",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "aiuis-cms"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "658027e659b046e68ae70cb464e10cd0"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "DERIVE_QUEUE",
        "queue": "aiuis-cms-derive"
      }
    ],
    "consumers": [
      {
        "queue": "aiuis-cms-derive",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },
  "vars": {
    "ENVIRONMENT": "production"
  },
  "routes": [{ "pattern": "cms.aiu.is", "custom_domain": true }],
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_AGENT",
        "class_name": "CmsMcpAgent"
      },
      {
        "name": "LOCK_ROOM",
        "class_name": "LockRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      // Workers Free only allows SQLite-backed DOs; storage API is the same
      "new_sqlite_classes": ["CmsMcpAgent", "LockRoom"]
    }
  ]
}
